{
  "conference_name": "NeurIPS",
  "conference_year": 2025,
  "max_pages": 9,
  "min_pages": 1,
  "blind_review": true,
  "reference_style": "bibtex",
  "required_sections": ["abstract", "introduction", "methodology", "results", "conclusion"],
  "optional_sections": ["appendix", "supplementary_material"],
  "required_keywords": [],
  "margin_rules": {
    "top_cm": 2.5,
    "bottom_cm": 2.5,
    "left_cm": 2.5,
    "right_cm": 2.5
  },
  "package_template": "neurips_2025.sty",
  "scoring_weights": {
    "critical": 20,
    "warning": 8,
    "info": 2
  },
  "anonymity_rules": {
    "requires_anonymous_submission": true,
    "allow_supplementary_material": true,
    "allow_arxiv_submission": false
  },
  "submission_requirements": {
    "min_references": 5,
    "max_figures": 10,
    "max_tables": 5,
    "requires_ethical_statement": true
  }
}
