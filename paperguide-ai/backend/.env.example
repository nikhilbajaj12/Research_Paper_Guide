# Environment Configuration for PaperGuide AI Backend

# App
APP_NAME=PaperGuide AI
APP_VERSION=0.1.0
DEBUG=True
ENV=development

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Database
# For SQLite (MVP):
DATABASE_URL=sqlite:///./paperguide.db

# For PostgreSQL (future):
# DATABASE_URL=postgresql://user:password@localhost/paperguide

# File Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
MAX_PDF_SIZE_MB=50

# Paths
DATA_DIR=./data
GUIDELINES_DIR=./data/guidelines
TEMP_DIR=./temp

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# TODO: Add when implementing Phase 2
# OPENAI_API_KEY=sk-...
# CELERY_BROKER_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/1
